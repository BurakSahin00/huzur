# Yerelde gerçek değerleri server/.env dosyasına yaz. Render'da aynı adlarla ortam değişkeni olarak gir.
# Bu örnek depoya girer, .env girmez. Repo herkese açık: gizli değer commit'lenirse anahtarı hemen değiştir.
RPC_URL=https://testnet-rpc.monad.xyz
CONTRACT_ADDRESS=
ILKGELEN_ADDRESS=

# CORS: virgülle ayrılmış ön yüz adresleri (Vercel üretim adresi ve yerel geliştirme)
WEB_ORIGINS=http://localhost:5173
# İsteğe bağlı: Vercel önizleme adresleri için düzenli ifade
WEB_ORIGIN_REGEX=

# Sunucu anahtarı: OPERATOR_ROLE, SIGNER_ROLE ve GATE_ROLE bu adrese verilir.
# Yönetici (dağıtım) anahtarı burada DEĞİL, Foundry keystore'unda durur.
OPERATOR_PRIVATE_KEY=

# Bot demosu için ayrı anahtar
BOT_PRIVATE_KEY=

# Üretmek için: openssl rand -hex 32
HMAC_KEY=
# Kura tohumları bundan türetilir; diskte tohum dosyası yok
SEED_KEY=
ADMIN_TOKEN=

# Uygulamanın Claude anahtarı. Kabuğa export etme: export edilirse Claude Code aboneliğin yerine bunu kullanır.
ANTHROPIC_API_KEY=
